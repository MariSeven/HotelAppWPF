<Window x:Class="HotelAppWPF.account"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelAppWPF"
        mc:Ignorable="d"
        Style="{DynamicResource LightTheme}" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="491*"/>
            <ColumnDefinition Width="69*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Left" Grid.ColumnSpan="2">
            <Button x:Name="btnTheme" Style="{DynamicResource LightThemeBTN}" Content="Темная тема" Height="30" Margin="0 0 0 15" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAdd" Style="{DynamicResource LightThemeBTN}" Content="Добавить" Height="40" Margin="0 0 10 15" Width="130"/>
                <Button x:Name="btnEdit" Style="{DynamicResource LightThemeBTN}" Content="Редакт." Height="40" Margin="0 0 10 15" Width="130"/>
                <Button x:Name="btnDelete" Style="{DynamicResource LightThemeBTN}" Content="Удалить" Height="40" Margin="0 0 10 15" Width="130"/>
                <Button x:Name="btnUpdate" Style="{DynamicResource LightThemeBTN}" Content="Обновить" Height="40" Margin="0 0 10 15" Width="130"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal">
            <Button x:Name="btnRoom" Style="{DynamicResource LightThemeBTN}" Content="Номера" Height="40" Width="120" Background="#6060AA"/>
            <Button x:Name="btnBooking" Style="{DynamicResource LightThemeBTN}" Content="Бронирования" Height="40" Width="180" Background="#BBBBBB" Foreground="#707070"/>
        </StackPanel>
        <ListView x:Name="lstRoom" Grid.Row="2" Style="{DynamicResource LightThemeLST}" Visibility="Visible" Grid.ColumnSpan="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding RoomID}"/>
                    <GridViewColumn Header="Номер" Width="80" DisplayMemberBinding="{Binding RoomNumber}"/>
                    <GridViewColumn Header="Класс" Width="120" DisplayMemberBinding="{Binding RoomClass}"/>
                    <GridViewColumn Header="Вместимость" Width="100" DisplayMemberBinding="{Binding RoomCapacity}"/>
                    <GridViewColumn Header="Цена" Width="100" DisplayMemberBinding="{Binding RoomPrice, StringFormat={}{0} руб.}"/>
                    <GridViewColumn Header="Статус" Width="100" DisplayMemberBinding="{Binding RoomStatus}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <ListView x:Name="lstBooking" Grid.Row="2" Style="{DynamicResource LightThemeLST}" Visibility="Collapsed" Grid.ColumnSpan="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="40"  DisplayMemberBinding="{Binding BookingID}"/>
                    <GridViewColumn Header="ФИО" Width="100" DisplayMemberBinding="{Binding BookingFullNameLodger}"/>
                    <GridViewColumn Header="Номер" Width="100" DisplayMemberBinding="{Binding BookingNumberRoom}"/>
                    <GridViewColumn Header="Заезд" Width="100" DisplayMemberBinding="{Binding BookingDateStart}"/>
                    <GridViewColumn Header="Выезд" Width="100" DisplayMemberBinding="{Binding BookingDateStop}"/>
                    <GridViewColumn Header="Сумма" Width="100" DisplayMemberBinding="{Binding BookingPrice, StringFormat={}{0} руб.}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
