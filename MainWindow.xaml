<Window x:Class="HotelAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelAppWPF"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindow}"
        WindowStartupLocation="CenterScreen">
    <StackPanel HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Логин" Margin="0 120 35 0"/>
            <TextBox x:Name="txtLogin" Margin="0 120 0 0" Height="35" Width="300"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Пароль" Margin="0 20 20 0"/>
            <TextBox x:Name="txtPassword" Margin="0 20 0 0" Height="35" Width="300"/>
        </StackPanel>
        <Button x:Name="btnLogin" Content="Войти" Margin="0 70 0 50" />
        <Button x:Name="btnExit" Content="Выйти" />

    </StackPanel>
</Window>
