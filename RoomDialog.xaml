<Window x:Class="HotelAppWPF.RoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Номер" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Номер комнаты:" Grid.Row="0" Grid.Column="0" Margin="5" FontSize="18"/>
        <TextBox x:Name="txtRoomNumber" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Класс:" Grid.Row="1" Grid.Column="0" Margin="5" FontSize="18"/>
        <ComboBox x:Name="cmbRoomClass" Grid.Row="1" Grid.Column="1" Margin="5">
            <ComboBoxItem Content="Стандарт"/>
            <ComboBoxItem Content="Полулюкс"/>
            <ComboBoxItem Content="Люкс"/>
        </ComboBox>

        <TextBlock Text="Количество мест:" Grid.Row="2" Grid.Column="0" Margin="5" FontSize="17"/>
        <TextBox x:Name="txtCapacity" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Цена за сутки:" Grid.Row="3" Grid.Column="0" Margin="5" FontSize="18"/>
        <TextBox x:Name="txtPrice" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Статус:" Grid.Row="4" Grid.Column="0" Margin="5" FontSize="18"/>
        <ComboBox x:Name="cmbStatus" Grid.Row="4" Grid.Column="1" Margin="5">
            <ComboBoxItem Content="свободен"/>
            <ComboBoxItem Content="занят"/>
        </ComboBox>

        <TextBlock x:Name="txtError" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                   Foreground="Red" Margin="5" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="130" Height="40" Margin="5" />
            <Button x:Name="btnCancel" Content="Отмена" Width="130" Height="40" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>