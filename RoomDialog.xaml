<Window x:Class="HotelAppWPF.RoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource LightTheme}"
        Title="Номер" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="txt1" Text="Номер комнаты:" Style="{DynamicResource LightThemeTXT}" Grid.Row="0" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="txtRoomNumber" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock x:Name="txt2" Text="Класс:" Style="{DynamicResource LightThemeTXT}" Grid.Row="1" Grid.Column="0" Margin="5" />
        <ComboBox x:Name="cmbRoomClass" Grid.Row="1" Grid.Column="1" Margin="5">
            <ComboBoxItem Content="Стандарт"/>
            <ComboBoxItem Content="Полулюкс"/>
            <ComboBoxItem Content="Люкс"/>
        </ComboBox>

        <TextBlock x:Name="txt3" Text="Количество мест:" Style="{DynamicResource LightThemeTXT}" Grid.Row="2" Grid.Column="0" Margin="5" FontSize="17"/>
        <TextBox x:Name="txtCapacity" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock x:Name="txt4" Text="Цена за сутки:" Style="{DynamicResource LightThemeTXT}" Grid.Row="3" Grid.Column="0" Margin="5" />
        <TextBox x:Name="txtPrice" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock x:Name="txt5" Text="Статус:" Grid.Row="4" Style="{DynamicResource LightThemeTXT}" Grid.Column="0" Margin="5" />
        <ComboBox x:Name="cmbStatus" Grid.Row="4" Grid.Column="1" Margin="5">
            <ComboBoxItem Content="свободен"/>
            <ComboBoxItem Content="занят"/>
        </ComboBox>

        <TextBlock x:Name="txtError" Style="{DynamicResource LightThemeTXT}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                   Foreground="Red" Margin="5" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSave" Style="{DynamicResource LightThemeBTN}" Content="Сохранить" Width="130" Height="40" Margin="5" />
            <Button x:Name="btnCancel" Style="{DynamicResource LightThemeBTN}" Content="Отмена" Width="130" Height="40" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>